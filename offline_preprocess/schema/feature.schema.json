{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/feature.schema.json",
  "title": "离线建档预处理单图特征",
  "description": "客观统计结果，不含场景语义、风格结论或摄影师参数推断。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "feature_schema_version",
    "preprocess_version",
    "image_id",
    "source_sha256",
    "config_hash",
    "statistics_source",
    "source",
    "geometry",
    "color_management",
    "warnings",
    "luminance",
    "rgb",
    "lab",
    "hue",
    "saturation",
    "palette",
    "spatial",
    "sharpness",
    "similarity"
  ],
  "properties": {
    "feature_schema_version": { "type": "string", "minLength": 1 },
    "preprocess_version": { "type": "string", "minLength": 1 },
    "image_id": { "type": "string", "pattern": "^img_[0-9a-f]{16}$" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "config_hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "statistics_source": { "const": "normalized_srgb_resized_before_jpeg" },
    "source": {
      "type": "object",
      "required": ["file_name", "format", "size_bytes", "image_mode", "was_grayscale"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "enum": ["JPEG", "PNG", "TIFF", "WEBP"] },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "image_mode": { "type": "string", "minLength": 1 },
        "was_grayscale": { "type": "boolean" }
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "decoded_width",
        "decoded_height",
        "oriented_width",
        "oriented_height",
        "output_width",
        "output_height",
        "aspect_ratio",
        "scale",
        "target_long_edge",
        "resampled",
        "rounding_rule",
        "orientation",
        "orientation_applied"
      ],
      "properties": {
        "decoded_width": { "type": "integer", "minimum": 1 },
        "decoded_height": { "type": "integer", "minimum": 1 },
        "oriented_width": { "type": "integer", "minimum": 1 },
        "oriented_height": { "type": "integer", "minimum": 1 },
        "output_width": { "type": "integer", "minimum": 1 },
        "output_height": { "type": "integer", "minimum": 1 },
        "aspect_ratio": { "type": "number", "exclusiveMinimum": 0 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "target_long_edge": { "type": "integer", "minimum": 1 },
        "resampled": { "type": "boolean" },
        "resample_filter": { "type": ["string", "null"] },
        "rounding_rule": { "type": "string", "minLength": 1 },
        "orientation": { "type": "integer", "minimum": 1, "maximum": 8 },
        "orientation_applied": { "type": "boolean" }
      }
    },
    "color_management": {
      "type": "object",
      "required": ["output_color_space", "icc_present", "assumed_srgb", "grayscale_converted"],
      "properties": {
        "output_color_space": { "const": "sRGB" },
        "icc_present": { "type": "boolean" },
        "icc_description": { "type": ["string", "null"] },
        "assumed_srgb": { "type": "boolean" },
        "grayscale_converted": { "type": "boolean" },
        "conversion_path": { "type": "string" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "luminance": {
      "type": "object",
      "required": ["mean", "std", "percentiles", "histogram", "near_black_ratio", "near_white_ratio"],
      "properties": {
        "mean": { "type": "number", "minimum": 0, "maximum": 1 },
        "std": { "type": "number", "minimum": 0, "maximum": 1 },
        "percentiles": {
          "type": "object",
          "required": ["p1", "p5", "p10", "p25", "p50", "p75", "p90", "p95", "p99"],
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "histogram": {
          "type": "object",
          "required": ["bins", "range", "counts"],
          "properties": {
            "bins": { "type": "integer", "minimum": 2 },
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            },
            "counts": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "near_black_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "near_white_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "rgb": {
      "type": "object",
      "required": ["r", "g", "b"],
      "properties": {
        "r": { "$ref": "#/$defs/channel" },
        "g": { "$ref": "#/$defs/channel" },
        "b": { "$ref": "#/$defs/channel" }
      }
    },
    "lab": {
      "type": "object",
      "required": ["L", "a", "b", "chroma"],
      "properties": {
        "L": { "$ref": "#/$defs/lab_component" },
        "a": { "$ref": "#/$defs/lab_component" },
        "b": { "$ref": "#/$defs/lab_component" },
        "chroma": {
          "type": "object",
          "required": ["mean", "std", "p50", "p90"],
          "properties": {
            "mean": { "type": "number", "minimum": 0 },
            "std": { "type": "number", "minimum": 0 },
            "p50": { "type": "number", "minimum": 0 },
            "p90": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "hue": {
      "type": "object",
      "required": ["bins", "range_degrees", "chroma_weighted", "histogram", "chromatic_pixel_ratio"],
      "properties": {
        "bins": { "type": "integer", "minimum": 2 },
        "range_degrees": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "chroma_weighted": { "type": "boolean" },
        "min_chroma": { "type": "number", "minimum": 0 },
        "histogram": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "chromatic_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "saturation": {
      "type": "object",
      "required": ["mean", "std", "p50", "p90"],
      "properties": {
        "mean": { "type": "number", "minimum": 0, "maximum": 1 },
        "std": { "type": "number", "minimum": 0, "maximum": 1 },
        "p50": { "type": "number", "minimum": 0, "maximum": 1 },
        "p90": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["hex", "ratio", "lab"],
        "properties": {
          "hex": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
          "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
          "lab": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" }
          }
        }
      }
    },
    "spatial": {
      "type": "object",
      "required": ["grid", "cells"],
      "properties": {
        "grid": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "cells": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "type": "object",
            "required": ["row", "col", "mean_l", "mean_chroma"],
            "properties": {
              "row": { "type": "integer", "minimum": 0, "maximum": 2 },
              "col": { "type": "integer", "minimum": 0, "maximum": 2 },
              "mean_l": { "type": "number" },
              "mean_chroma": { "type": "number", "minimum": 0 }
            }
          }
        },
        "image_width": { "type": "integer", "minimum": 1 },
        "image_height": { "type": "integer", "minimum": 1 }
      }
    },
    "sharpness": {
      "type": "object",
      "required": ["laplacian_variance", "method"],
      "properties": {
        "laplacian_variance": { "type": "number", "minimum": 0 },
        "method": { "type": "string", "minLength": 1 },
        "luminance_scale": { "type": "string" }
      }
    },
    "similarity": {
      "type": "object",
      "required": ["phash", "algorithm"],
      "properties": {
        "phash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "algorithm": { "type": "string", "minLength": 1 }
      }
    },
    "exif_summary": {
      "type": ["object", "null"],
      "properties": {
        "camera_make": { "type": ["string", "null"] },
        "camera_model": { "type": ["string", "null"] },
        "lens_model": { "type": ["string", "null"] },
        "iso": { "type": ["integer", "null"] },
        "exposure_time_seconds": { "type": ["number", "null"] },
        "exposure_time": { "type": ["string", "null"] },
        "f_number": { "type": ["number", "null"] },
        "focal_length_mm": { "type": ["number", "null"] },
        "datetime_original": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": ["mean", "std", "p5", "p50", "p95", "low_clip_ratio", "high_clip_ratio"],
      "properties": {
        "mean": { "type": "number", "minimum": 0, "maximum": 1 },
        "std": { "type": "number", "minimum": 0, "maximum": 1 },
        "p5": { "type": "number", "minimum": 0, "maximum": 1 },
        "p50": { "type": "number", "minimum": 0, "maximum": 1 },
        "p95": { "type": "number", "minimum": 0, "maximum": 1 },
        "low_clip_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "high_clip_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "lab_component": {
      "type": "object",
      "required": ["mean", "std", "p5", "p50", "p95"],
      "properties": {
        "mean": { "type": "number" },
        "std": { "type": "number", "minimum": 0 },
        "p5": { "type": "number" },
        "p50": { "type": "number" },
        "p95": { "type": "number" }
      }
    }
  }
}
