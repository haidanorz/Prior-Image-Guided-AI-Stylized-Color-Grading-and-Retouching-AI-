{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/offline_profile/analysis.schema.json",
  "title": "单图视觉分析（规范化后）",
  "description": "AI 只看单张预览与客观特征；本 Schema 只描述可见观察与编辑假设，不含正式场景桶判定。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_schema_version",
    "image_id",
    "source_sha256",
    "input_fingerprint",
    "model_info",
    "prompt_version",
    "scene_observation",
    "visual_observation",
    "narrative_observation",
    "edit_hypotheses",
    "quality",
    "local_adjustments_suspected",
    "overall_impression",
    "warnings"
  ],
  "properties": {
    "analysis_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "image_id": {
      "type": "string",
      "pattern": "^img_[0-9a-f]{16}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "model_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "version",
        "is_mock"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "is_mock": {
          "type": "boolean"
        }
      }
    },
    "scene_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_candidates",
        "lighting",
        "subject",
        "brightness",
        "backlit",
        "backlit_evidence",
        "environment_notes"
      ],
      "properties": {
        "primary_candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "score"
            ],
            "properties": {
              "label": {
                "enum": [
                  "portrait",
                  "natural_landscape",
                  "urban_architecture",
                  "street_documentary",
                  "indoor",
                  "still_life",
                  "other"
                ]
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "lighting": {
          "enum": [
            "daylight",
            "golden_hour",
            "overcast",
            "artificial",
            "night",
            "mixed",
            "unknown"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "brightness": {
          "enum": [
            "bright",
            "mid",
            "dark"
          ]
        },
        "backlit": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        },
        "backlit_evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "environment_notes": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "visual_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrast",
        "shadow_detail",
        "highlight_rolloff",
        "black_level",
        "warmth",
        "saturation_global",
        "saturation_skin",
        "saturation_sky",
        "saturation_foliage",
        "shadow_tint_strength",
        "highlight_tint_strength",
        "grain_visibility",
        "vignette_visibility",
        "sharpness_impression",
        "clarity_impression"
      ],
      "properties": {
        "contrast": {
          "$ref": "#/$defs/ordinal"
        },
        "shadow_detail": {
          "$ref": "#/$defs/ordinal"
        },
        "highlight_rolloff": {
          "$ref": "#/$defs/ordinal"
        },
        "black_level": {
          "$ref": "#/$defs/ordinal"
        },
        "warmth": {
          "$ref": "#/$defs/ordinal"
        },
        "saturation_global": {
          "$ref": "#/$defs/ordinal"
        },
        "saturation_skin": {
          "$ref": "#/$defs/ordinal"
        },
        "saturation_sky": {
          "$ref": "#/$defs/ordinal"
        },
        "saturation_foliage": {
          "$ref": "#/$defs/ordinal"
        },
        "shadow_tint_strength": {
          "$ref": "#/$defs/ordinal"
        },
        "highlight_tint_strength": {
          "$ref": "#/$defs/ordinal"
        },
        "grain_visibility": {
          "$ref": "#/$defs/ordinal"
        },
        "vignette_visibility": {
          "$ref": "#/$defs/ordinal"
        },
        "sharpness_impression": {
          "$ref": "#/$defs/ordinal"
        },
        "clarity_impression": {
          "$ref": "#/$defs/ordinal"
        }
      }
    },
    "edit_hypotheses": {
      "type": "object",
      "description": "键必须在参数登记表中；每项包含 estimate/range/confidence/evidence。",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,40}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/edit_slot"
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "issues",
        "confidence"
      ],
      "properties": {
        "overall": {
          "enum": [
            "good",
            "acceptable",
            "poor",
            "unknown"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "enum": [
              "soft_focus",
              "motion_blur",
              "noise",
              "banding",
              "overexposed",
              "underexposed",
              "heavy_compression",
              "low_resolution",
              "other"
            ]
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "local_adjustments_suspected": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region",
          "kind",
          "evidence",
          "confidence"
        ],
        "properties": {
          "region": {
            "enum": [
              "sky",
              "subject",
              "background",
              "foreground",
              "edges",
              "mixed",
              "unknown"
            ]
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "overall_impression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "narrative_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mood",
        "atmosphere",
        "light_quality",
        "sense_of_place",
        "seasonal_cues",
        "composition_rhythm",
        "keywords",
        "basis"
      ],
      "properties": {
        "mood": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "atmosphere": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "light_quality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "sense_of_place": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "seasonal_cues": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "composition_rhythm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "keywords": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  },
  "$defs": {
    "ordinal": {
      "enum": [
        "very_low",
        "low",
        "neutral",
        "high",
        "very_high",
        "unknown"
      ]
    },
    "edit_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "range",
        "confidence",
        "evidence"
      ],
      "properties": {
        "estimate": {
          "type": "number"
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    }
  }
}
