{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "online_decode/model_brief.json",
  "title": "模型 brief 响应（首轮之前）",
  "type": "object",
  "required": [
    "branch_rationale",
    "preserve",
    "goals",
    "avoid"
  ],
  "properties": {
    "image_id": {
      "type": "string"
    },
    "scene_observation": {
      "type": "object",
      "required": [
        "primary_candidates"
      ],
      "properties": {
        "primary_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "score"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          }
        },
        "lighting": {
          "type": "string"
        },
        "brightness": {
          "type": "string"
        },
        "backlit": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "branch_rationale": {
      "type": "string",
      "minLength": 10
    },
    "hit_cautions": {
      "type": "array"
    },
    "hit_exceptions": {
      "type": "array"
    },
    "preserve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "goals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "avoid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "initial_xmp": {
      "type": "string"
    },
    "initial_plan": {
      "type": "array"
    },
    "param_notes": {
      "type": "object"
    },
    "target_corrections": {
      "type": "array"
    },
    "uncertainties": {
      "type": "array"
    }
  },
  "anyOf": [
    {
      "required": [
        "initial_xmp"
      ]
    },
    {
      "required": [
        "initial_plan"
      ]
    }
  ],
  "additionalProperties": true
}
