  "workflow": {
    "order": [
      "Exposure2012",
      "Highlights2012",
      "Shadows2012",
      "Whites2012",
      "Blacks2012",
      "Contrast2012",
      "Exposure2012@touchup"
    ],
    "summary": "先定中点（曝光），再定两端（高光/阴影、白点/黑点），最后回头调对比，末尾再补一次曝光。",
    "steps": [
      {
        "step": 1,
        "field": "Exposure2012",
        "do": "定中间调亮度，暂时不管高光和阴影",
        "tip": "多数图比「看着刚好」再亮 +0.25 到 +0.50 EV 效果更好",
        "quote": "Set Exposure to correct the image mid-tone brightness ignoring the highlight and shadow areas for now. Setting Exposure slightly higher (+.25 to +.50 EV) than what looks correct for the mid-tones seems to work best with most images."
      },
      {
        "step": 2,
        "field": "Contrast2012",
        "do": "先留在 0，第一遍不要动",
        "quote": "Leave Contrast at 0 for now. It's better to adjust this after the first pass."
      },
      {
        "step": 3,
        "field": "Highlights2012",
        "do": "压到过曝区恢复、细部层次出来为止",
        "quote": "Adjust Highlights so that the blown out areas are recovered and/or the fine tonal detail is revealed."
      },
      {
        "step": 4,
        "field": "Shadows2012",
        "do": "提到暗部细节出来为止；常规图取与高光等值反向",
        "quote": "For most normal images, simply setting +Shadows the same as -Highlights (for example, +50 and -50) works well."
      },
      {
        "step": 5,
        "field": "Whites2012",
        "do": "按住 Alt/Option 拖，直到黑色背景上开始出现剪切",
        "quote": "The Whites control sets the white clipping point, which you can see by holding down the ALT/Option key as you move the slider."
      },
      {
        "step": 6,
        "field": "Blacks2012",
        "do": "按住 Alt/Option 拖，直到白色背景上开始出现剪切",
        "quote": "The Blacks control sets the black clipping point, which you can see by holding down the ALT/Option key as you move the slider."
      },
      {
        "step": 7,
        "field": "Contrast2012",
        "do": "回来只调中间调对比，忽略它对整体对比的影响",
        "quote": "Now go back and adjust the Contrast control to establish the best midtone contrast. Ignore its effect on the overall image contrast. That is set by the Whites and Blacks clipping point controls."
      },
      {
        "step": 8,
        "field": "Exposure2012",
        "do": "末尾再补一次中间调亮度",
        "quote": "Lastly, touch up the Exposure control for the best midtone brightness."
      }
    ],
    "equal_opposite_rule": {
      "rule": "高光与阴影尽量等值反向（-H ≈ +S），否则直方图整体左移或右移，会与其它所有控制区产生强交互，越调越乱。",
      "quote": "If the settings are not kept equal and opposite, the image data levels shift to the left or right in the histogram causing a much stronger interaction with all of the other control areas.",
      "project_note": "指纹锚点本身是摄影师风格，不保证 -H == +S（例如 global 是 highlights -11 / shadows 无锚点）。本规则只用于判断「调完是否需要返工」，不得反过来修改锚点。"
    },
    "dynamic_range_guidance": {
      "high_dynamic_range": {
        "when": "暗部很深、高光很亮",
        "range": "Highlights/Shadows 幅度可超过 50，从 -60/+60 到 -100/+100",
        "quote": "Very high dynamic range images with deep shadows and bright highlights may require higher than 50 settings (-60, +60 up to -100, +100) to reveal detail in those areas."
      },
      "low_contrast": {
        "when": "没有真正深暗部和亮点，如阴天、雾天",
        "range": "Highlights/Shadows 取小值甚至 0/0；这类图反而应动 Contrast / Clarity / Dehaze",
        "quote": "Subjects with no deep shadows or bright highlights (that is, overcast lighting or fog) may require lower values (-40, +40 to 0, 0) to maintain contrast. In fact, these are the types of images that may require using +Contrast, +Clarity, or +Dehaze."
      }
    }
  },
  "tone_zones": {
    "Exposure2012": [
      30,
      70
    ],
    "Contrast2012": [
      30,
      70
    ],
    "Highlights2012": [
      70,
      90
    ],
    "Shadows2012": [
      10,
      30
    ],
    "Whites2012": [
      90,
      100
    ],
    "Blacks2012": [
      0,
      10
    ],
    "_note": "数值为直方图亮度百分比区间，来自 Adobe 官方 Tone Control 文档的 Tone Control target areas。用于判断「这个动作该不该由这个参数承担」：例如纯白天空已处 90-100%，压 Highlights 无效，应由 Whites 负责。"
  },
  "entries": [
    {
      "field": "Temperature",
      "display": "Temperature (K)",
      "group": "whitebalance",
      "writable": true,
      "effect": {
        "increase": "色温升高，画面转暖/偏黄",
        "decrease": "色温降低，画面转冷/偏蓝"
      },
      "use_when": [
        "还原现场光色",
        "统一多图白平衡"
      ],
      "caution": [
        "RAW 用 Kelvin 温标；JPEG/TIFF/PSD 只有 -100~100 温标，范围更窄",
        "改白平衡必须同时把 WhiteBalance 设为 Custom，否则不生效"
      ],
      "quote": "色温可设置您的照片呈现的黄色/暖或蓝色/冷程度。将该滑块左移可降低照片的色温，将其右移可提高照片的色温。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "Tint",
      "display": "Tint",
      "group": "whitebalance",
      "writable": true,
      "effect": {
        "increase": "加洋红（抵消偏绿）",
        "decrease": "加绿（抵消偏洋红）"
      },
      "use_when": [
        "荧光灯偏绿",
        "局部阴影偏色"
      ],
      "caution": [
        "阴影区残留绿/洋红偏色优先用 ShadowTint（属 tier=ext，本接口写不进）",
        "Tint 全图生效，改之前先确认偏色是全局还是只在暗部"
      ],
      "quote": "「色调」可设置您的照片呈现的绿色或洋红色程度。将滑块左移（负值）可给照片添加绿色；将滑块右移（正值）可添加洋红。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "WhiteBalance",
      "display": "White Balance",
      "group": "whitebalance",
      "writable": true,
      "effect": {
        "increase": "枚举值，选择白平衡模式（As Shot / Auto / Custom 等）",
        "decrease": "同上"
      },
      "use_when": [
        "任何要动 Temperature 或 Tint 的场合"
      ],
      "caution": [
        "必须设为 Custom，否则 Temperature/Tint 改动不生效——这是写 XMP 最容易漏的一步"
      ],
      "quote": "白平衡预设选项仅适用于 Raw 照片和 DNG 照片。使用滑块可以编辑所有照片的白平衡。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "Exposure2012",
      "display": "Exposure",
      "group": "basic",
      "writable": true,
      "tone_zone": [
        30,
        70
      ],
      "effect": {
        "increase": "整体提亮，作用于中间调",
        "decrease": "整体压暗，作用于中间调"
      },
      "use_when": [
        "先定中间调亮度的第一步",
        "末尾复核一次"
      ],
      "caution": [
        "+1.00 约等于光圈 +1 档，幅度不要凭感觉给",
        "它动的是中间调；极暗或极亮区要靠 Shadows/Highlights，不要用曝光硬拉"
      ],
      "quote": "曝光度值的递增与相机光圈值（光圈大小）的递增等量相当。将曝光度调整 +1.00 相当于使光圈值增加 1。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "Contrast2012",
      "display": "Contrast",
      "group": "basic",
      "writable": true,
      "tone_zone": [
        30,
        70
      ],
      "effect": {
        "increase": "中间调对比增强：中间偏暗更暗、中间偏亮更亮",
        "decrease": "中间调对比减弱"
      },
      "use_when": [
        "整体发闷、发灰",
        "低对比场景（阴天、雾天）补救"
      ],
      "caution": [
        "只影响中间调，不要用它调整体对比——整体对比由 Whites/Blacks 剪切点决定",
        "流程上应放在高光/阴影之后，第一遍留 0"
      ],
      "quote": "增加或降低图像对比度，主要影响中间色调。增加对比度时，中间色调到暗色调的图像区域会变得更暗，而中间色调到亮色调的图像区域会变得更亮。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "Highlights2012",
      "display": "Highlights",
      "group": "basic",
      "writable": true,
      "tone_zone": [
        70,
        90
      ],
      "effect": {
        "increase": "提亮高光，同时尽量不产生剪切",
        "decrease": "压暗高光，恢复被压平的高光细节"
      },
      "use_when": [
        "云层过曝",
        "亮部细节被压平"
      ],
      "caution": [
        "只管 70-90%；已达 90-100% 的纯白区压它基本无效，那里是 Whites 的职责",
        "与阴影尽量等值反向，否则直方图整体漂移，需要大量返工"
      ],
      "quote": "调整图像明亮区域。向左拖动可使高光变暗，并恢复「模糊化的」高光细节。向右拖动可使高光变亮，同时最小化剪切。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "Shadows2012",
      "display": "Shadows",
      "group": "basic",
      "writable": true,
      "tone_zone": [
        10,
        30
      ],
      "effect": {
        "increase": "提亮暗部，恢复阴影细节",
        "decrease": "压暗暗部，同时最小化剪切"
      },
      "use_when": [
        "暗部死黑但需要结构",
        "逆光欠曝的暗部"
      ],
      "caution": [
        "提到 +40 以上容易发灰发脏，也容易把噪点提上来",
        "指纹是暗调风格时，提阴影等于直接削弱风格——先看 narrative 再决定"
      ],
      "quote": "调整黑暗图像区域。向左拖动可使阴影变暗，同时最小化剪切。向右拖动可使阴影变亮，并恢复阴影细节。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "Whites2012",
      "display": "Whites",
      "group": "basic",
      "writable": true,
      "tone_zone": [
        90,
        100
      ],
      "effect": {
        "increase": "提高白点，增加高光剪切（镜面高光可适当接受）",
        "decrease": "降低白点，减少高光剪切"
      },
      "use_when": [
        "需要明确白点在哪",
        "整体动态范围没用满"
      ],
      "caution": [
        "它定义的是白点，不是「提亮亮部」——想提亮亮部细节用 Highlights",
        "雾天/低对比图可以允许不给白点剪切（取更低值），保住空气感"
      ],
      "quote": "调整白色色阶剪切。向左拖动可减少高光剪切。向右拖动可增加高光剪切。（对于镜面高光（如金属表面），可能需要增加剪切。）",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "Blacks2012",
      "display": "Blacks",
      "group": "basic",
      "writable": true,
      "tone_zone": [
        0,
        10
      ],
      "effect": {
        "increase": "降低黑点，减少阴影剪切（黑更黑）",
        "decrease": "提高黑点，让阴影更早过渡到纯黑，画面更「扎实」"
      },
      "use_when": [
        "画面发灰缺底",
        "需要压出暗部重量"
      ],
      "caution": [
        "注意方向与 Whites 相反：向左才是「更黑」，容易与直觉搞反",
        "压过头会把暗部结构整片吃掉，夜景尤其危险"
      ],
      "quote": "调整黑色色阶剪切。向左拖动可增加黑色色阶剪切（将更多的阴影映射到纯黑色）。向右拖动可减少阴影剪切。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "Clarity2012",
      "display": "Clarity",
      "group": "basic",
      "writable": true,
      "effect": {
        "increase": "增强局部对比，画面更「立体」、更有力",
        "decrease": "柔化，画面发柔"
      },
      "use_when": [
        "主体结构需要强化",
        "雾气场景需要中景分离"
      ],
      "caution": [
        "官方建议放大到 100% 调，加到边缘出现光晕再往回减一点",
        "人像慎用，会把皮肤纹理和瑕疵一起拉出来"
      ],
      "quote": "通过增加局部对比度来增加图像深度。使用此设置时，最好放大到 100% 或更大。要使效果达到最佳，请增大该设置值，直到您看到图像边缘细节附近出现光晕，然后再稍微减小该值。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "Texture",
      "display": "Texture",
      "group": "basic",
      "writable": true,
      "effect": {
        "increase": "突出中频纹理细节",
        "decrease": "平滑中频细节"
      },
      "use_when": [
        "需要加细节但不想要 Clarity 那种整体厚重感"
      ],
      "caution": [
        "不动颜色和色调，是三者里最「干净」的加细节手段",
        "与 Clarity 不同，它不牵动黑白场"
      ],
      "quote": "平滑或突出照片中的纹理细节。向左移动滑块可平滑细节；向右移动滑块可突出细节。调整「纹理」滑块时，颜色和色调不会更改。",
      "source_ref": "adobe_cn_effects",
      "manifest_tier": "v1"
    },
    {
      "field": "Dehaze",
      "display": "Dehaze",
      "group": "basic",
      "writable": true,
      "effect": {
        "increase": "去雾，压掉空气透视、提升对比与饱和",
        "decrease": "加雾，制造空气感（负值）"
      },
      "use_when": [
        "镜头雾化/眩光导致的低对比：15-25 通常够",
        "真实大气雾：可用更高值"
      ],
      "caution": [
        "推过会同时加蓝、加饱和，需要回头压蓝饱和",
        "大气雾本身是这个场景的情绪来源时，压掉雾就等于毁掉风格——先看 narrative"
      ],
      "quote": "The Dehaze control is useful for images with visible atmospheric haze (fog, smog, smoke) and images with low contrast due to lens flare or other lens issues. In the latter case, adding a Dehaze setting of 15-25 may be just what's needed to add some life back into the otherwise flat images. Atmospheric haze often requires higher settings and may also require using the local controls.",
      "source_ref": "adobe_tone_control",
      "manifest_tier": "v1"
    },
    {
      "field": "Vibrance",
      "display": "Vibrance",
      "group": "basic",
      "writable": true,
      "effect": {
        "increase": "提升低饱和颜色的饱和，对已高饱和的颜色影响小",
        "decrease": "降低饱和度，优先削低饱和部分"
      },
      "use_when": [
        "整体加饱和的首选",
        "含肤色的画面"
      ],
      "caution": [
        "接近最大饱和时自动减少剪切，所以不会像 Saturation 那样溢出",
        "它优先作用于偏冷/低饱和区，加暖调不如 Saturation 直接"
      ],
      "quote": "调整饱和度以便在颜色接近最大饱和度时最大限度地减少剪切，从而更改所有低饱和度的颜色的饱和度，而对高饱和度的颜色的影响较小。适当设置鲜艳度还可避免肤色变得过度饱和。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "Saturation",
      "display": "Saturation",
      "group": "basic",
      "writable": true,
      "effect": {
        "increase": "所有颜色统一加倍饱和",
        "decrease": "所有颜色统一降饱和，-100 为黑白"
      },
      "use_when": [
        "需要整体统一压/提饱和"
      ],
      "caution": [
        "全局无差别，最先把红色和橙黄推爆",
        "和 Vibrance 叠加容易过量，通常只用其一"
      ],
      "quote": "将所有图像颜色的饱和度从 100（黑白）同步调整为 +100（使饱和度翻倍）。",
      "source_ref": "adobe_cn_tone_color",
      "manifest_tier": "v1"
    },
    {
      "field": "ConvertToGrayscale",
      "display": "Convert to B&W",
      "group": "basic",
      "writable": true,
      "effect": {
        "increase": "转黑白",
        "decrease": "回彩色"
      },
      "use_when": [
        "明确要黑白输出时"
      ],
      "caution": [
        "一旦为真，所有 HSL 与颜色分级效果失去意义",
        "指纹是彩色风格时不应打开"
